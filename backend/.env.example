# ============================================
# BusGijon Backend — Environment Variables
# ============================================
# Copy this file to .env and fill in real values.
# DO NOT commit the .env file (it is gitignored).

# --- EMTUSA OAuth2 Credentials ---
# Basic auth header: "Basic <base64 of clientId:clientSecret>"
EMTUSA_AUTH_BASIC=Basic <base64-of-clientId:clientSecret>
EMTUSA_AUTH_USER=usuario@ejemplo.com
EMTUSA_AUTH_PASS=tu_contraseña

# --- EMTUSA API Base URL ---
EMTUSA_BASE_URL=https://emtusasiri.pub.gijon.es/emtusasiri/

# --- SQLite Database Path ---
DB_PATH=busgijon.db

# --- VAPID Keys for Web Push ---
# Generate with: python -m py_vapid --generate-keys
# Or: py_vapid -k vapid_key.pem (then extract keys)
VAPID_PUBLIC_KEY=<your-public-key>
VAPID_PRIVATE_KEY=<your-private-key>
VAPID_SUBJECT=mailto:admin@example.com

# --- Push Poller Settings ---
POLL_INTERVAL_SECONDS=30

# --- Server Settings ---
HOST=127.0.0.1
PORT=8000
